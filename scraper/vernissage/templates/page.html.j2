<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Stockholm Vernissages</title>
<meta name="description" content="Exhibition openings at Stockholm galleries over the next {{ window }} days. Updated nightly.">
<link rel="icon" href="/favicon.png">
<link rel="alternate" type="text/calendar" title="Stockholm Vernissages" href="events.ics">
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="">
<script defer src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
<style>
  :root {
    --bg: #FAFAF7; --ink: #111111; --muted: #6B6B66; --rule: #DADAD4;
    --font: "Helvetica Neue", Helvetica, Arial, sans-serif;
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body { margin: 0; background: var(--bg); color: var(--ink); font: 16px/1.45 var(--font); }
  a { color: inherit; text-decoration-thickness: 1px; text-underline-offset: 3px; }
  .wrap { max-width: 960px; margin: 0 auto; padding: 56px 24px 80px; }
  /* Header: centered; serif display face from the visitor's system (Iowan Old Style on Apple devices,
     Palatino or Georgia elsewhere; no web-font download). Subtitle darker than --muted for legibility. */
  header { text-align: center; }
  header h1 { font-family: "Iowan Old Style", "Palatino Linotype", Palatino, "Book Antiqua", Georgia, serif;
              font-size: 48px; font-weight: 400; line-height: 1.1; letter-spacing: -0.005em; margin: 0 0 12px; }
  header p { color: #2F2F2C; font-size: 18px; margin: 0 auto; max-width: 760px; }
  /* Event banner: centered, borderless, white on burgundy (distinct from the red used for "day after"). */
  header p.notice { --notice: #7A1F2B; display: block; width: fit-content; max-width: 100%; margin: 20px auto 0;
                    padding: 10px 18px; background: var(--notice); color: #fff; text-align: center; border: 0; }
  header p.notice a { color: #fff; text-decoration: none; }
  header p.notice a:hover, header p.notice a:focus { text-decoration: underline; }
  .filters { display: flex; flex-wrap: wrap; gap: 6px 18px; align-items: baseline;
             margin: 40px 0 0; padding: 0 0 16px; border-bottom: 1px solid var(--ink); font-size: 14px; }
  .filters button { font: inherit; color: var(--muted); background: none; border: 0; padding: 0; cursor: pointer; }
  .filters button[aria-pressed="true"] { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }
  .filters label { color: var(--muted); cursor: pointer; }
  .district-row { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; width: 100%; margin: 10px 0 0; }
  /* Districts: borderless fills graded light to darker from Östermalm outward (list order); selected = black. */
  .filters .district-row button { font-size: 15px; font-weight: 500; color: var(--ink); background: var(--shade, #F6F4EF);
                                  border: 0; padding: 5px 12px; text-decoration: none; }
  .filters .district-row button:hover { box-shadow: inset 0 0 0 1px var(--ink); }
  .filters .district-row button[aria-pressed="true"] { background: var(--ink); color: #fff; }
  /* Confirmed: borderless toggle between the day buttons and the map buttons; black when on. */
  .filters .confirmed { display: inline-flex; align-items: center; font-weight: 500; color: var(--ink); background: #E8E6E0;
                        padding: 3px 10px; cursor: pointer; border: 1px solid transparent; }
  .filters .confirmed:has(input:checked) { background: var(--ink); color: #fff; }
  .filters .confirmed:has(input:focus-visible) { outline: 2px solid var(--ink); outline-offset: 2px; }
  .filters .confirmed input { position: absolute; opacity: 0; width: 1px; height: 1px; margin: 0; }
  /* Day shortcuts: light gray = two days ago, gray = yesterday, green = today, yellow = tomorrow, red = day after.
     Dates are worked out in the browser in Stockholm time (days change at 00:00 CET/CEST). */
  :root { --past60: #5C5A55; --twodays: #C9C9C4; --yesterday: #8A8A85; --today: #1E7B34; --tomorrow: #F2C230; --dayafter: #C62828; }
  .when-filter { display: flex; flex-wrap: wrap; gap: 6px; width: 100%; margin: 0 0 6px; }
  .when-filter button { color: var(--ink) !important; border: 1px solid var(--ink) !important; padding: 3px 8px !important;
                        text-decoration: none !important; }
  .when-filter button.dm2 { border-color: var(--twodays) !important; }
  .when-filter button.dm2[aria-pressed="true"] { background: var(--twodays); }
  .when-filter button.dm1 { border-color: var(--yesterday) !important; }
  .when-filter button.d0 { border-color: var(--today) !important; }
  .when-filter button.d1 { border-color: var(--tomorrow) !important; }
  .when-filter button.d0[aria-pressed="true"] { background: var(--today); color: #fff !important; }
  .when-filter button.d1[aria-pressed="true"] { background: var(--tomorrow); }
  .when-filter button.d2 { border-color: var(--dayafter) !important; }
  .when-filter button.dm1[aria-pressed="true"] { background: var(--yesterday); color: #fff !important; }
  .when-filter button.d2[aria-pressed="true"] { background: var(--dayafter); color: #fff !important; }
  /* Unpressed: tinted fill of the day color (opaque); pressed: solid day color. */
  .when-filter button { font-weight: 500 !important; }
  .when-filter button.dm2:not([aria-pressed="true"]) { background: #EDEDEA; }
  .when-filter button.dm1:not([aria-pressed="true"]) { background: #E2E2DF; }
  .when-filter button.d0:not([aria-pressed="true"]) { background: #DCEDE0; }
  .when-filter button.d1:not([aria-pressed="true"]) { background: #FCF0C8; }
  .when-filter button.d2:not([aria-pressed="true"]) { background: #F6DADA; }
  .when-filter button:disabled { opacity: 0.5; cursor: default; }
  .tag { display: inline-block; margin-top: 6px; padding: 1px 8px; font-size: 12px; letter-spacing: 0.04em; font-style: normal; }
  .tag:empty { display: none; }
  .tag.t0 { background: var(--today); color: #fff; }
  .tag.t1 { background: var(--tomorrow); color: var(--ink); }
  .tag.t2 { background: var(--dayafter); color: #fff; }
  .tag.tm2 { background: var(--twodays); color: var(--ink); }
  .tag.tm1 { background: var(--yesterday); color: #fff; }
  .day { display: grid; grid-template-columns: 200px 1fr; gap: 24px; padding: 28px 0; border-bottom: 1px solid var(--rule); }
  .day h2 { font-size: 15px; font-weight: 400; margin: 2px 0 0; }
  .day h2 span { display: block; color: var(--muted); }
  /* Listing: gallery (bold caps), title (serif), artists (medium), vernissage (bold), dates, address (muted). */
  .ev { padding: 0 0 22px; }
  .ev + .ev { border-top: 1px solid var(--rule); padding-top: 22px; }
  .ev:last-child { padding-bottom: 0; }
  .ev .venue { font-size: 13px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; margin: 0 0 6px; }
  .ev h3 { font-family: "Iowan Old Style", "Palatino Linotype", Palatino, "Book Antiqua", Georgia, serif;
           font-size: 25px; font-weight: 600; line-height: 1.2; margin: 0; }
  .ev h3 .gloss { color: var(--muted); font-weight: 400; }
  .ev .artists { margin: 4px 0 0; font-size: 17px; font-weight: 500; }
  .ev .when { margin: 10px 0 0; font-size: 15px; font-weight: 700; }
  .ev .when.unconfirmed { color: var(--muted); font-weight: 400; font-style: italic; }
  .ev .dates { margin: 2px 0 0; font-size: 15px; color: #2F2F2C; }
  .ev .meta { margin: 2px 0 0; font-size: 14px; color: var(--muted); }
  .ev .links { margin: 8px 0 0; font-size: 14px; display: flex; gap: 18px; }
  .empty { padding: 40px 0; color: var(--muted); }
  footer { margin-top: 48px; font-size: 13px; color: var(--muted); }
  footer p { margin: 0 0 4px; }
  [hidden] { display: none !important; }
  /* Map: OpenStreetMap tiles via Leaflet. Numbered pins; filled = opening in the window. */
  .map-wrap { margin: 40px 0 0; }
  #map { height: 380px; border: 1px solid var(--ink); background: #EEEEEA; }
  .map-wrap.full { position: fixed; inset: 0; z-index: 1000; margin: 0; padding: 12px; background: var(--bg);
                   display: flex; flex-direction: column; }
  .map-wrap.full #map { flex: 1; height: auto; }
  .map-wrap.full .key { display: none; }
  .map-close { display: none; }
  /* Close map: borderless, white on black (red is reserved for "day after tomorrow"). */
  .map-wrap.full .map-close { display: block; position: absolute; top: 22px; right: 22px; z-index: 1001; font: inherit;
                              font-size: 15px; font-weight: 600; color: #fff; background: var(--ink); border: 0;
                              padding: 8px 14px; cursor: pointer; box-shadow: 0 1px 4px rgba(0, 0, 0, 0.35); }
  .map-wrap.full .map-close:hover, .map-wrap.full .map-close:focus-visible { background: #333; }
  .dot { display: inline-block; width: 10px; height: 10px; border-radius: 50%; border: 1.5px solid var(--ink);
         background: var(--bg); vertical-align: -1px; margin: 0 4px 0 12px; }
  .dot.on { background: var(--ink); }
  /* Legend: two centered rows of filter buttons under the map (days; then past, next, none). */
  .legend { display: flex; flex-direction: column; align-items: center; gap: 10px; margin: 24px 0 28px; font-size: 16px; }
  .legend-row { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 24px; }
  .legend button { font: inherit; color: var(--ink); background: none; border: 0; padding: 0; cursor: pointer; }
  .legend button[aria-pressed="true"] { text-decoration: underline; text-underline-offset: 4px; }
  .legend .dot { width: 13px; height: 13px; margin: 0 7px 0 0; vertical-align: -1px; }
  .when-row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-start; gap: 8px 16px;
              width: 100%; margin: 0 0 6px; }
  .when-row .when-filter { width: auto; margin: 0; }
  .when-row { column-gap: 8px; }
  .filters .map-actions { display: flex; gap: 6px; margin-left: auto; }
  /* Map buttons (Gallery list, Expand map): borderless, white on two shades of deep blue (one per function); blue carries no day meaning here. */
  .filters .map-actions button { color: #fff; background: var(--action); border: 0; padding: 5px 10px; text-decoration: none; }
  .filters .map-actions #key-toggle { --action: #1F4E79; --action-dark: #163A5C; }
  .filters .map-actions #map-expand { --action: #2E6A9E; --action-dark: #23557F; }
  .filters .map-actions button:hover, .filters .map-actions button:focus-visible,
  .filters .map-actions button[aria-expanded="true"] { background: var(--action-dark); }
  .pin span { display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: 22px; height: 22px;
              border-radius: 50%; border: 1.5px solid var(--ink); background: var(--bg); color: var(--ink); font: 600 11px/1 var(--font); }
  .pin.on span { background: var(--ink); color: var(--bg); }
  /* After .pin.on so the day colors win: light gray two days ago, gray yesterday, green today, yellow tomorrow, red day after. */
  .dot.p60, .pin.on.p60 span { background: var(--past60); border-color: var(--past60); color: #fff; }
  .dot.dm2, .pin.on.dm2 span { background: var(--twodays); border-color: var(--twodays); color: var(--ink); }
  .dot.dm1, .pin.on.dm1 span { background: var(--yesterday); border-color: var(--yesterday); color: #fff; }
  .dot.d0, .pin.on.d0 span { background: var(--today); border-color: var(--today); color: #fff; }
  .dot.d1, .pin.on.d1 span { background: var(--tomorrow); border-color: var(--tomorrow); color: var(--ink); }
  .dot.d2, .pin.on.d2 span { background: var(--dayafter); border-color: var(--dayafter); color: #fff; }
  .key { margin: 12px 0 0; font-size: 14px; }
  .map-actions { display: flex; gap: 8px; flex-wrap: wrap; }
  .key-group { margin: 14px 0 0; break-inside: avoid; }
  .key h4 { font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; font-weight: 400; margin: 0 0 4px; }
  .key ol { margin: 0; padding-left: 28px; }
  .key-groups { display: grid; grid-template-columns: 1fr 1fr; column-gap: 32px; align-items: start; }
  .key li button { font: inherit; color: inherit; background: none; border: 0; padding: 0; cursor: pointer; text-align: left;
                   text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }
  .key .count { color: var(--muted); }
  .leaflet-popup-content { font: 14px/1.4 var(--font); margin: 12px 14px; }
  .pop p { margin: 2px 0; }
  .pop .pop-name { font-weight: 600; }
  .pop ul { margin: 6px 0; padding-left: 16px; }
  .pop .pop-none { color: var(--muted); }
  @media (max-width: 640px) {
    .wrap { padding: 32px 16px 56px; }
    header h1 { font-size: 34px; }
    header p { font-size: 16px; }
    .day { grid-template-columns: 1fr; gap: 12px; }
    .when-filter { flex-wrap: wrap; }
    header p.notice { padding: 10px 14px; }
    #map { height: 300px; }
    .key-groups { grid-template-columns: 1fr; }
  }
</style>
</head>
<body>
<div class="wrap">
  <header>
    <h1>Stockholm Vernissages</h1>
    <p>Exhibition openings at {{ n_venues }} Stockholm galleries over the next {{ window }} days. Updated nightly.</p>
    {% if weekend %}<p class="notice"><a href="{{ weekend.slug or 'gallery-weekend' }}/">{{ weekend.name }}, {{ weekend.start.day }}{% if weekend.start.month != weekend.end.month %} {{ weekend.start.strftime('%B') }}{% endif %}–{{ weekend.end.day }} {{ weekend.end.strftime('%B') }}: full program of openings, talks, and tours</a></p>{% endif %}
  </header>

  {% if n_points %}
  <section class="map-wrap" id="map-wrap" aria-label="Map of galleries">
    <div id="map" data-window="{{ window }}" role="region" aria-label="Map of {{ n_points }} galleries. Filled pins have an opening in the next {{ window }} days."></div>
    <button type="button" id="map-close" class="map-close">Close map</button>
    <div class="legend" role="group" aria-label="Show on the map and in the list">
      <div class="legend-row">
        <button type="button" data-when="m2" aria-pressed="false"><span class="dot dm2"></span><span class="lbl">Two days ago</span></button>
        <button type="button" data-when="m1" aria-pressed="false"><span class="dot dm1"></span><span class="lbl">Yesterday</span></button>
        <button type="button" data-when="d0" aria-pressed="false"><span class="dot d0"></span><span class="lbl">Today</span></button>
        <button type="button" data-when="d1" aria-pressed="false"><span class="dot d1"></span><span class="lbl">Tomorrow</span></button>
        <button type="button" data-when="d2" aria-pressed="false"><span class="dot d2"></span><span class="lbl">Day after tomorrow</span></button>
      </div>
      <div class="legend-row">
        <button type="button" data-when="past" aria-pressed="false"><span class="dot p60"></span><span class="lbl">Past {{ window }} days</span></button>
        <button type="button" data-when="next" aria-pressed="false"><span class="dot on"></span><span class="lbl">Next {{ window }} days</span></button>
        <button type="button" data-when="none" aria-pressed="false"><span class="dot"></span><span class="lbl">No scheduled openings</span></button>
      </div>
    </div>
    <div class="key" id="map-key" hidden>
      <div class="key-groups">
      {% for col in key %}<div class="key-col">
      {% for district, pts in col %}<div class="key-group" data-district="{{ district }}"><h4>{{ district }}</h4><ol>
        {% for p in pts %}<li value="{{ p.n }}"><button type="button" data-pin="{{ p.id }}">{{ p.name }}</button>{% if p.openings %} <span class="count">{{ p.openings | length }} opening{{ "" if p.openings | length == 1 else "s" }}</span>{% endif %}</li>
        {% endfor %}</ol></div>
      {% endfor %}
      </div>{% endfor %}
      </div>
    </div>
  </section>
  <script type="application/json" id="map-data">{{ map_json | safe }}</script>
  {% endif %}

  {% if districts %}
  <nav class="filters" aria-label="Filter">
    <div class="when-row">
    <div class="when-filter" role="group" aria-label="Show one day">
      <button type="button" class="dm2" data-when="m2" aria-pressed="false">Two days ago</button>
      <button type="button" class="dm1" data-when="m1" aria-pressed="false">Yesterday</button>
      <button type="button" class="d0" data-when="d0" aria-pressed="false">Today</button>
      <button type="button" class="d1" data-when="d1" aria-pressed="false">Tomorrow</button>
      <button type="button" class="d2" data-when="d2" aria-pressed="false">Day after tomorrow</button>
    </div>
    <label class="confirmed"><input type="checkbox" id="confirmed">Confirmed</label>
    {% if n_points %}<div class="map-actions">
      <button type="button" id="key-toggle" aria-expanded="false" aria-controls="map-key">Gallery list ({{ n_points }})</button>
      <button type="button" id="map-expand" aria-expanded="false">Expand map</button>
    </div>{% endif %}
    </div>
    <div class="district-row" role="group" aria-label="Neighborhood">
    <button type="button" data-district="" aria-pressed="true">All</button>
    {% set shades = ["#F1EFEA", "#ECE9E3", "#E7E4DD", "#E2DED6", "#DDD9D0", "#D8D3C9", "#D3CEC3", "#CEC8BC", "#C9C3B6"] %}
    {% for d in districts %}<button type="button" data-district="{{ d }}" aria-pressed="false" style="--shade: {{ shades[loop.index0] if loop.index0 < shades|length else shades[-1] }}">{{ d }}</button>
    {% endfor %}
    </div>
  </nav>
  {% endif %}

  <main>
  {% for day, events in days %}
    <section class="day" data-date="{{ day.isoformat() }}">
      <h2>{{ day.strftime("%A") }}<span>{{ day.day }} {{ day.strftime("%B") }}</span><em class="tag"></em></h2>
      <div>
      {% for e in events %}
        <article class="ev" data-district="{{ e.district or '' }}" data-confirmed="{{ 1 if e.opening.confirmed else 0 }}">
          <p class="venue">{{ e.venue }}</p>
          <h3>{{ e.title }}{% if e.title_en %} / {{ e.title_en }}{% endif %}{% if e.gloss %} <span class="gloss" title="English translation">[{{ e.gloss }}]</span>{% endif %}</h3>
          {% set artists = e.artists | join(", ") %}
          {% if artists and artists != e.title %}<p class="artists">{{ artists }}</p>{% endif %}
          {% if e.opening.confirmed %}
            <p class="when">Vernissage{% if e.opening.start_time %} {{ e.opening.start_time }}{% if e.opening.end_time %} to {{ e.opening.end_time }}{% endif %}{% endif %}{% if e.access == "invite" %}, by invitation{% endif %}</p>
          {% else %}
            <p class="when unconfirmed">Exhibition opens. Reception details not published.</p>
          {% endif %}
          {% if e.end_date %}<p class="dates">On view until {{ e.end_date | longdate }}</p>{% endif %}
          {% if e.address %}<p class="meta"><a href="{{ e.map_url }}" rel="noopener">{{ e.address }}</a></p>{% endif %}
          <p class="links"><a href="{{ e.url }}" rel="noopener">Gallery page</a><a href="ics/{{ e.id }}.ics">Add to calendar</a></p>
        </article>
      {% endfor %}
      </div>
    </section>
  {% else %}
    <p class="empty">No openings found for the next {{ window }} days.</p>
  {% endfor %}
  <p class="empty" id="none" hidden>No openings match this filter.</p>
  </main>

  <footer>
    <p>{{ n_events }} openings, {{ n_confirmed }} with confirmed reception times. Last updated {{ updated }}.</p>
    <p><a href="events.ics">Subscribe to the calendar</a>{% if repo_url %} · <a href="{{ repo_url }}">Source code</a>{% endif %} · Built by <a href="/">Alfred J. Jollon</a></p>
  </footer>
</div>
<script>
(function () {
  // One selection drives both the list and the map: district, day (or past / next / none), confirmed only.
  // Days change at 00:00 Stockholm time (CET/CEST), worked out in the visitor's browser.
  var sel = { district: "", when: "", confirmedOnly: false };
  var OFF = { m2: -2, m1: -1, d0: 0, d1: 1, d2: 2 };
  function stockholmDate(offset) {  // YYYY-MM-DD in Stockholm, offset in days
    var d = new Date(new Intl.DateTimeFormat("en-CA", { timeZone: "Europe/Stockholm", year: "numeric",
      month: "2-digit", day: "2-digit" }).format(new Date()) + "T12:00:00Z");
    d.setUTCDate(d.getUTCDate() + offset);
    return d.toISOString().slice(0, 10);
  }
  function weekday(iso) { return new Date(iso + "T12:00:00Z").toLocaleDateString("en-US", { weekday: "long", timeZone: "UTC" }); }
  var dates = {};
  Object.keys(OFF).forEach(function (k) { dates[k] = stockholmDate(OFF[k]); });
  window.vernissageDates = dates;  // shared with the map
  window.vernissageSel = sel;
  var tagText = { m2: "Two days ago", m1: "Yesterday", d0: "Today", d1: "Tomorrow", d2: "Day after tomorrow" };
  var tagCls = { m2: "tm2", m1: "tm1", d0: "t0", d1: "t1", d2: "t2" };
  // Outer days carry their weekday name on the buttons and in the legend.
  document.querySelectorAll('[data-when="m2"], [data-when="d2"]').forEach(function (b) {
    var lbl = b.querySelector(".lbl") || b; lbl.textContent = weekday(dates[b.dataset.when]);
  });
  // Days before today stay hidden until chosen; anything older than two days is dropped
  // (the page may have been built before midnight).
  document.querySelectorAll(".day[data-date]").forEach(function (day) {
    var d = day.dataset.date;
    if (d < dates.m2) day.dataset.stale = "1";
    else if (d < dates.d0) day.dataset.past = "1";
    Object.keys(OFF).forEach(function (k) {
      if (d === dates[k]) { var t = day.querySelector(".tag"); if (t) { t.textContent = tagText[k]; t.className = "tag " + tagCls[k]; } }
    });
    if (day.dataset.stale || day.dataset.past) day.hidden = true;
  });
  document.querySelectorAll(".when-filter button").forEach(function (b) {
    var day = document.querySelector('.day[data-date="' + dates[b.dataset.when] + '"]');
    if (day) b.textContent += " (" + day.querySelectorAll(".ev").length + ")";
    else { b.disabled = true; b.title = "No openings that day"; }
  });
  function dayVisible(d) {
    var w = sel.when;
    if (OFF.hasOwnProperty(w)) return d === dates[w];
    if (w === "past") return d < dates.d0;
    if (w === "none") return false;
    return d >= dates.d0;  // default and "next"
  }
  function apply() {
    var shown = 0;
    document.querySelectorAll(".day").forEach(function (day) {
      var any = false;
      day.querySelectorAll(".ev").forEach(function (ev) {
        var ok = (!sel.district || ev.dataset.district === sel.district) && (!sel.confirmedOnly || ev.dataset.confirmed === "1");
        ev.hidden = !ok; any = any || ok;
      });
      if (day.dataset.stale || !dayVisible(day.dataset.date)) any = false;
      day.hidden = !any; if (any) shown++;
    });
    var none = document.getElementById("none");
    if (none) {
      none.textContent = sel.when === "none" ? "These galleries have no openings in the past or next {{ window }} days. See the map."
        : sel.when === "past" ? "Earlier openings from the past {{ window }} days are shown on the map." : "No openings match this filter.";
      none.hidden = shown > 0 || !document.querySelector(".day");
    }
    if (window.vernissageMap) window.vernissageMap.filter(sel);
  }
  window.vernissageApply = apply;
  document.querySelectorAll("[data-when]").forEach(function (b) {
    b.addEventListener("click", function () {
      sel.when = sel.when === b.dataset.when ? "" : b.dataset.when;
      document.querySelectorAll("[data-when]").forEach(function (x) {
        x.setAttribute("aria-pressed", x.dataset.when === sel.when ? "true" : "false");
      });
      apply();
    });
  });
  var btns = document.querySelectorAll(".filters button[data-district]");
  btns.forEach(function (b) {
    b.addEventListener("click", function () {
      sel.district = b.dataset.district;
      btns.forEach(function (x) { x.setAttribute("aria-pressed", x === b ? "true" : "false"); });
      apply();
    });
  });
  var box = document.getElementById("confirmed");
  if (box) box.addEventListener("change", function () { sel.confirmedOnly = box.checked; apply(); });
})();

document.addEventListener("DOMContentLoaded", function () {
  var wrap = document.getElementById("map-wrap"), el = document.getElementById("map"),
      data = document.getElementById("map-data");
  if (!wrap || !el || !data) return;
  if (!window.L) { wrap.hidden = true; return; }  // map library unavailable: the list still works
  var days = el.dataset.window, pts = JSON.parse(data.textContent);
  var map = L.map(el, { scrollWheelZoom: false });
  L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", { maxZoom: 19,
    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors' }).addTo(map);
  function node(tag, cls, text) {
    var n = document.createElement(tag); if (cls) n.className = cls; if (text != null) n.textContent = text; return n;
  }
  function link(href, text) { var a = node("a", null, text); a.href = href; a.rel = "noopener"; a.target = "_blank"; return a; }
  var markers = {}, all = [], central = [];
  var D = window.vernissageDates || null;
  pts.forEach(function (p) {
    var box = node("div", "pop");
    box.appendChild(node("p", "pop-name", p.n + ". " + p.name));
    if (p.address) {
      var ap = node("p"); ap.appendChild(link(p.map_url, p.address));
      if (p.floor) ap.appendChild(document.createTextNode(", " + p.floor));
      box.appendChild(ap);
    }
    if (p.openings.length) {
      var ul = node("ul");
      p.openings.forEach(function (o) {
        ul.appendChild(node("li", null, o.date + ": " + o.title + (o.time ? ". Vernissage " + o.time : "")));
      });
      box.appendChild(ul);
    } else {
      box.appendChild(node("p", "pop-none", "No openings in the next " + days + " days."));
    }
    if (p.url) { var wp = node("p"); wp.appendChild(link(p.url, "Gallery website")); box.appendChild(wp); }
    // Upcoming first: today green, tomorrow yellow, day after red, later in 60 days black.
    // With nothing upcoming: gray yesterday, light gray two days ago, dark gray earlier in the past 60 days.
    var isos = p.openings.map(function (o) { return o.iso; });
    p.isos = isos;
    p.up = D ? isos.filter(function (x) { return x >= D.d0; }) : isos;
    p.pastAll = (p.past || []).concat(D ? isos.filter(function (x) { return x < D.d0; }) : []);
    var cls = "", soon = -1;
    if (D) {
      ["d0", "d1", "d2"].forEach(function (k, i) { if (soon < 0 && isos.indexOf(D[k]) >= 0) soon = i; });
      if (soon >= 0) cls = " on d" + soon;
      else if (p.up.length) cls = " on";
      else if (isos.indexOf(D.m1) >= 0) cls = " on dm1";
      else if (isos.indexOf(D.m2) >= 0) cls = " on dm2";
      else if (p.pastAll.length) cls = " on p60";
    } else if (isos.length) cls = " on";
    var icon = L.divIcon({ className: "pin" + cls,
                           html: "<span>" + p.n + "</span>", iconSize: [22, 22], iconAnchor: [11, 11], popupAnchor: [0, -12] });
    markers[p.id] = L.marker([p.lat, p.lon], { icon: icon, title: p.n + ". " + p.name, alt: p.n + ". " + p.name,
                                               zIndexOffset: soon >= 0 ? 2000 - soon * 100 : (p.up.length ? 1000 : 0) })
                     .addTo(map).bindPopup(box);
    all.push([p.lat, p.lon]); if (p.central) central.push([p.lat, p.lon]);
  });
  // Home view: all central galleries. Until the visitor drags the map or a filter moves it, the + button zooms
  // in on the middle of the gallery cluster (median position), not on the middle of the bounding box.
  var base = central.length ? central : all, home = true, homeCenter = null;
  function median(a) { var s = a.slice().sort(function (x, y) { return x - y; }), n = s.length;
                       return n % 2 ? s[(n - 1) / 2] : (s[n / 2 - 1] + s[n / 2]) / 2; }
  if (base.length) homeCenter = [median(base.map(function (x) { return x[0]; })), median(base.map(function (x) { return x[1]; }))];
  function fitAll() { map.fitBounds(base, { padding: [24, 24] }); home = true; }
  fitAll();
  map.on("dragstart", function () { home = false; });
  el.addEventListener("click", function (e) {
    var zin = e.target.closest && e.target.closest(".leaflet-control-zoom-in");
    if (!zin || !home || !homeCenter || zin.classList.contains("leaflet-disabled")) return;
    e.preventDefault(); e.stopPropagation();  // capture phase: runs before Leaflet's own zoom-in handler
    map.setView(homeCenter, Math.min(map.getZoom() + 1, map.getMaxZoom()));
  }, true);

  // District filter: show only that district's pins and zoom to them; "All" restores everything.
  function matchesWhen(p, w) {
    if (!w || !D) return true;
    if (D.hasOwnProperty(w)) return p.isos.indexOf(D[w]) >= 0;
    if (w === "next") return p.up.length > 0;
    if (w === "past") return p.pastAll.length > 0;
    if (w === "none") return !p.up.length && !p.pastAll.length;
    return true;
  }
  window.vernissageMap = { filter: function (sel) {
    var shown = [], d = sel.district, w = sel.when;
    pts.forEach(function (p) {
      var m = markers[p.id], on = (!d || p.district === d) && matchesWhen(p, w);
      m.__shown = on;
      if (on) { if (!map.hasLayer(m)) m.addTo(map); shown.push([p.lat, p.lon]); }
      else { m.closePopup(); map.removeLayer(m); }
    });
    document.querySelectorAll(".key-group").forEach(function (g) { g.hidden = !!d && g.dataset.district !== d; });
    if (!d && !w) fitAll();
    else if (!shown.length) return;
    else if (shown.length === 1) { home = false; map.setView(shown[0], 15); }
    else { home = false; map.fitBounds(shown, { padding: [24, 24], maxZoom: 16 }); }
  } };

  var keyBtn = document.getElementById("key-toggle"), keyBox = document.getElementById("map-key");
  if (keyBtn && keyBox) {
    var keyLabel = keyBtn.textContent;
    keyBtn.addEventListener("click", function () {
      var show = keyBox.hidden;
      keyBox.hidden = !show;
      keyBtn.textContent = show ? "Hide gallery list" : keyLabel;
      keyBtn.setAttribute("aria-expanded", show ? "true" : "false");
    });
  }

  var btn = document.getElementById("map-expand");
  function expand(on) {
    wrap.classList.toggle("full", on);
    btn.textContent = on ? "Close map" : "Expand map";
    btn.setAttribute("aria-expanded", on ? "true" : "false");
    document.body.style.overflow = on ? "hidden" : "";
    on ? map.scrollWheelZoom.enable() : map.scrollWheelZoom.disable();
    setTimeout(function () { map.invalidateSize(); }, 50);
  }
  btn.addEventListener("click", function () { expand(!wrap.classList.contains("full")); });
  var closeBtn = document.getElementById("map-close");
  if (closeBtn) closeBtn.addEventListener("click", function () { expand(false); });
  document.addEventListener("keydown", function (e) { if (e.key === "Escape" && wrap.classList.contains("full")) expand(false); });
  document.querySelectorAll(".key button[data-pin]").forEach(function (b) {
    b.addEventListener("click", function () {
      var m = markers[b.dataset.pin]; if (!m) return;
      // A gallery the current day or district filter hides is shown just while its popup is open.
      if (!map.hasLayer(m)) {
        m.addTo(map);
        m.once("popupclose", function () { if (m.__shown === false) map.removeLayer(m); });
      }
      el.scrollIntoView({ behavior: "smooth", block: "center" });
      // Jump without animation (opening a popup mid-animation pans to stale positions), open the popup,
      // then center the pin and its popup together so the gallery sits in the middle of the map.
      var ll = m.getLatLng(), z = Math.max(map.getZoom(), 16);
      home = false; map.setView(ll, z, { animate: false }); m.openPopup();
      var pe = m.getPopup() && m.getPopup().getElement(), h = pe ? pe.offsetHeight + 12 : 0;
      map.setView(map.unproject(map.project(ll, z).subtract([0, h / 2]), z), z, { animate: false });
    });
  });
});
</script>
</body>
</html>
