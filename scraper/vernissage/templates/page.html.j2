<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Stockholm Vernissages</title>
<meta name="description" content="Exhibition openings at Stockholm galleries over the next {{ window }} days. Updated nightly.">
<link rel="icon" href="/favicon.png">
<link rel="alternate" type="text/calendar" title="Stockholm Vernissages" href="events.ics">
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="">
<script defer src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
<style>
  :root {
    --bg: #FAFAF7; --ink: #111111; --muted: #6B6B66; --rule: #DADAD4;
    --font: "Helvetica Neue", Helvetica, Arial, sans-serif;
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body { margin: 0; background: var(--bg); color: var(--ink); font: 16px/1.45 var(--font); }
  a { color: inherit; text-decoration-thickness: 1px; text-underline-offset: 3px; }
  .wrap { max-width: 960px; margin: 0 auto; padding: 56px 24px 80px; }
  header h1 { font-size: 32px; font-weight: 400; letter-spacing: -0.01em; margin: 0 0 8px; }
  header p { color: var(--muted); margin: 0; max-width: 560px; }
  .filters { display: flex; flex-wrap: wrap; gap: 6px 18px; align-items: baseline;
             margin: 40px 0 0; padding: 0 0 16px; border-bottom: 1px solid var(--ink); font-size: 14px; }
  .filters button { font: inherit; color: var(--muted); background: none; border: 0; padding: 0; cursor: pointer; }
  .filters button[aria-pressed="true"] { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }
  .filters label { margin-left: auto; color: var(--muted); cursor: pointer; }
  .day { display: grid; grid-template-columns: 200px 1fr; gap: 24px; padding: 28px 0; border-bottom: 1px solid var(--rule); }
  .day h2 { font-size: 15px; font-weight: 400; margin: 2px 0 0; }
  .day h2 span { display: block; color: var(--muted); }
  .ev { padding: 0 0 24px; }
  .ev:last-child { padding-bottom: 0; }
  .ev .venue { font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; margin: 0 0 4px; }
  .ev h3 { font-size: 22px; font-weight: 400; line-height: 1.25; margin: 0; }
  .ev h3 .gloss { color: var(--muted); }
  .ev .artists { margin: 2px 0 0; }
  .ev .when { margin: 8px 0 0; font-size: 15px; }
  .ev .when.unconfirmed { color: var(--muted); }
  .ev .meta { margin: 2px 0 0; font-size: 14px; color: var(--muted); }
  .ev .links { margin: 8px 0 0; font-size: 14px; display: flex; gap: 18px; }
  .empty { padding: 40px 0; color: var(--muted); }
  footer { margin-top: 48px; font-size: 13px; color: var(--muted); }
  footer p { margin: 0 0 4px; }
  [hidden] { display: none !important; }
  /* Map: OpenStreetMap tiles via Leaflet. Numbered pins; filled = opening in the window. */
  .map-wrap { margin: 40px 0 0; }
  #map { height: 380px; border: 1px solid var(--ink); background: #EEEEEA; }
  .map-wrap.full { position: fixed; inset: 0; z-index: 1000; margin: 0; padding: 12px; background: var(--bg);
                   display: flex; flex-direction: column; }
  .map-wrap.full #map { flex: 1; height: auto; }
  .map-wrap.full .key { display: none; }
  .map-bar { display: flex; justify-content: space-between; align-items: center; gap: 8px 16px; flex-wrap: wrap;
             padding: 8px 0 0; font-size: 13px; color: var(--muted); }
  .map-bar button { font: inherit; color: var(--ink); background: none; border: 1px solid var(--ink); padding: 4px 10px; cursor: pointer; }
  .dot { display: inline-block; width: 10px; height: 10px; border-radius: 50%; border: 1.5px solid var(--ink);
         background: var(--bg); vertical-align: -1px; margin: 0 4px 0 12px; }
  .dot.on { background: var(--ink); margin-left: 0; }
  .pin span { display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: 22px; height: 22px;
              border-radius: 50%; border: 1.5px solid var(--ink); background: var(--bg); color: var(--ink); font: 600 11px/1 var(--font); }
  .pin.on span { background: var(--ink); color: var(--bg); }
  .key { margin: 12px 0 0; font-size: 14px; }
  .key summary { cursor: pointer; color: var(--muted); }
  .key-group { margin: 14px 0 0; break-inside: avoid; }
  .key h4 { font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; font-weight: 400; margin: 0 0 4px; }
  .key ol { margin: 0; padding-left: 28px; }
  .key-groups { columns: 2 280px; column-gap: 32px; }
  .key li button { font: inherit; color: inherit; background: none; border: 0; padding: 0; cursor: pointer; text-align: left;
                   text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }
  .key .count { color: var(--muted); }
  .leaflet-popup-content { font: 14px/1.4 var(--font); margin: 12px 14px; }
  .pop p { margin: 2px 0; }
  .pop .pop-name { font-weight: 600; }
  .pop ul { margin: 6px 0; padding-left: 16px; }
  .pop .pop-none { color: var(--muted); }
  @media (max-width: 640px) {
    .wrap { padding: 32px 16px 56px; }
    header h1 { font-size: 26px; }
    .day { grid-template-columns: 1fr; gap: 12px; }
    .filters label { margin-left: 0; width: 100%; }
    #map { height: 300px; }
  }
</style>
</head>
<body>
<div class="wrap">
  <header>
    <h1>Stockholm Vernissages</h1>
    <p>Exhibition openings at {{ n_venues }} Stockholm galleries over the next {{ window }} days. Updated nightly.</p>
  </header>

  {% if n_points %}
  <section class="map-wrap" id="map-wrap" aria-label="Map of galleries">
    <div id="map" data-window="{{ window }}" role="region" aria-label="Map of {{ n_points }} galleries. Filled pins have an opening in the next {{ window }} days."></div>
    <div class="map-bar">
      <span><span class="dot on"></span>Opening in the next {{ window }} days<span class="dot"></span>Other galleries</span>
      <button type="button" id="map-expand" aria-expanded="false">Expand map</button>
    </div>
    <details class="key">
      <summary>All {{ n_points }} galleries on the map</summary>
      <div class="key-groups">
      {% for district, pts in key %}<div class="key-group"><h4>{{ district }}</h4><ol>
        {% for p in pts %}<li value="{{ p.n }}"><button type="button" data-pin="{{ p.id }}">{{ p.name }}</button>{% if p.openings %} <span class="count">{{ p.openings | length }} opening{{ "" if p.openings | length == 1 else "s" }}</span>{% endif %}</li>
        {% endfor %}</ol></div>
      {% endfor %}
      </div>
    </details>
  </section>
  <script type="application/json" id="map-data">{{ map_json | safe }}</script>
  {% endif %}

  {% if districts %}
  <nav class="filters" aria-label="Filter">
    <button type="button" data-district="" aria-pressed="true">All</button>
    {% for d in districts %}<button type="button" data-district="{{ d }}" aria-pressed="false">{{ d }}</button>
    {% endfor %}
    <label><input type="checkbox" id="confirmed"> Confirmed vernissages only</label>
  </nav>
  {% endif %}

  <main>
  {% for day, events in days %}
    <section class="day">
      <h2>{{ day.strftime("%A") }}<span>{{ day.day }} {{ day.strftime("%B") }}</span></h2>
      <div>
      {% for e in events %}
        <article class="ev" data-district="{{ e.district or '' }}" data-confirmed="{{ 1 if e.opening.confirmed else 0 }}">
          <p class="venue">{{ e.venue }}</p>
          <h3>{{ e.title }}{% if e.title_en %} / {{ e.title_en }}{% endif %}{% if e.gloss %} <span class="gloss" title="English translation">[{{ e.gloss }}]</span>{% endif %}</h3>
          {% set artists = e.artists | join(", ") %}
          {% if artists and artists != e.title %}<p class="artists">{{ artists }}</p>{% endif %}
          {% if e.opening.confirmed %}
            <p class="when">Vernissage{% if e.opening.start_time %} {{ e.opening.start_time }}{% if e.opening.end_time %} to {{ e.opening.end_time }}{% endif %}{% endif %}{% if e.access == "invite" %}, by invitation{% endif %}</p>
          {% else %}
            <p class="when unconfirmed">Exhibition opens. Reception details not published.</p>
          {% endif %}
          <p class="meta">{% if e.end_date %}Until {{ e.end_date | longdate }}. {% endif %}{% if e.address %}<a href="{{ e.map_url }}" rel="noopener">{{ e.address }}</a>{% endif %}</p>
          <p class="links"><a href="{{ e.url }}" rel="noopener">Gallery page</a><a href="ics/{{ e.id }}.ics">Add to calendar</a></p>
        </article>
      {% endfor %}
      </div>
    </section>
  {% else %}
    <p class="empty">No openings found for the next {{ window }} days.</p>
  {% endfor %}
  <p class="empty" id="none" hidden>No openings match this filter.</p>
  </main>

  <footer>
    <p>{{ n_events }} openings, {{ n_confirmed }} with confirmed reception times. Last updated {{ updated }}.</p>
    <p><a href="events.ics">Subscribe to the calendar</a>{% if repo_url %} · <a href="{{ repo_url }}">Source code</a>{% endif %} · Built by <a href="/">Alfred J. Jollon</a></p>
  </footer>
</div>
<script>
(function () {
  var district = "", confirmedOnly = false;
  var btns = document.querySelectorAll(".filters button");
  var box = document.getElementById("confirmed");
  function apply() {
    var shown = 0;
    document.querySelectorAll(".day").forEach(function (day) {
      var any = false;
      day.querySelectorAll(".ev").forEach(function (ev) {
        var ok = (!district || ev.dataset.district === district) && (!confirmedOnly || ev.dataset.confirmed === "1");
        ev.hidden = !ok; any = any || ok;
      });
      day.hidden = !any; if (any) shown++;
    });
    var none = document.getElementById("none");
    if (none) none.hidden = shown > 0 || !document.querySelector(".day");
  }
  btns.forEach(function (b) {
    b.addEventListener("click", function () {
      district = b.dataset.district;
      btns.forEach(function (x) { x.setAttribute("aria-pressed", x === b ? "true" : "false"); });
      apply();
    });
  });
  if (box) box.addEventListener("change", function () { confirmedOnly = box.checked; apply(); });
})();

document.addEventListener("DOMContentLoaded", function () {
  var wrap = document.getElementById("map-wrap"), el = document.getElementById("map"),
      data = document.getElementById("map-data");
  if (!wrap || !el || !data) return;
  if (!window.L) { wrap.hidden = true; return; }  // map library unavailable: the list still works
  var days = el.dataset.window, pts = JSON.parse(data.textContent);
  var map = L.map(el, { scrollWheelZoom: false });
  L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", { maxZoom: 19,
    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors' }).addTo(map);
  function node(tag, cls, text) {
    var n = document.createElement(tag); if (cls) n.className = cls; if (text != null) n.textContent = text; return n;
  }
  function link(href, text) { var a = node("a", null, text); a.href = href; a.rel = "noopener"; a.target = "_blank"; return a; }
  var markers = {}, all = [], central = [];
  pts.forEach(function (p) {
    var box = node("div", "pop");
    box.appendChild(node("p", "pop-name", p.n + ". " + p.name));
    if (p.address) { var ap = node("p"); ap.appendChild(link(p.map_url, p.address)); box.appendChild(ap); }
    if (p.openings.length) {
      var ul = node("ul");
      p.openings.forEach(function (o) {
        ul.appendChild(node("li", null, o.date + ": " + o.title + (o.time ? ". Vernissage " + o.time : "")));
      });
      box.appendChild(ul);
    } else {
      box.appendChild(node("p", "pop-none", "No openings in the next " + days + " days."));
    }
    if (p.url) { var wp = node("p"); wp.appendChild(link(p.url, "Gallery website")); box.appendChild(wp); }
    var icon = L.divIcon({ className: "pin" + (p.openings.length ? " on" : ""), html: "<span>" + p.n + "</span>",
                           iconSize: [22, 22], iconAnchor: [11, 11], popupAnchor: [0, -12] });
    markers[p.id] = L.marker([p.lat, p.lon], { icon: icon, title: p.n + ". " + p.name, alt: p.n + ". " + p.name,
                                               zIndexOffset: p.openings.length ? 1000 : 0 }).addTo(map).bindPopup(box);
    all.push([p.lat, p.lon]); if (p.central) central.push([p.lat, p.lon]);
  });
  map.fitBounds(central.length ? central : all, { padding: [24, 24] });

  var btn = document.getElementById("map-expand");
  function expand(on) {
    wrap.classList.toggle("full", on);
    btn.textContent = on ? "Close map" : "Expand map";
    btn.setAttribute("aria-expanded", on ? "true" : "false");
    document.body.style.overflow = on ? "hidden" : "";
    on ? map.scrollWheelZoom.enable() : map.scrollWheelZoom.disable();
    setTimeout(function () { map.invalidateSize(); }, 50);
  }
  btn.addEventListener("click", function () { expand(!wrap.classList.contains("full")); });
  document.addEventListener("keydown", function (e) { if (e.key === "Escape" && wrap.classList.contains("full")) expand(false); });
  document.querySelectorAll(".key button[data-pin]").forEach(function (b) {
    b.addEventListener("click", function () {
      var m = markers[b.dataset.pin]; if (!m) return;
      el.scrollIntoView({ behavior: "smooth", block: "center" });
      map.setView(m.getLatLng(), 16); m.openPopup();
    });
  });
});
</script>
</body>
</html>
